{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run QEMU GDB",
            "type": "shell",
            "command": "make qemu-gdb",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "tcp::26000"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}